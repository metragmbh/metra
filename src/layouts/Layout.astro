---
import '../styles/global.css';
import CookieBanner from '../components/CookieBanner.astro';
import { getEntry } from 'astro:content';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  canonical?: string;
}

const settings = await getEntry('settings', 'global');
const s = settings?.data;

const { 
  title = s?.seo?.defaultTitle || 'METRA Baulogistik & Projektsteuerung GmbH',
  description = s?.seo?.defaultDescription || '',
  ogImage = s?.seo?.ogImage || '/images/hero.webp',
  canonical = Astro.url.pathname
} = Astro.props;

const siteUrl = s?.seo?.siteUrl || 'https://www.metra-baulogistik.de';
const fullCanonical = `${siteUrl}${canonical}`;
const company = s?.company;

// Schema.org JSON-LD
const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: company?.name || 'METRA Baulogistik & Projektsteuerung GmbH',
  url: siteUrl,
  logo: `${siteUrl}/images/logoneu.png`,
  address: {
    '@type': 'PostalAddress',
    streetAddress: company?.street || 'Im Mediapark 5',
    addressLocality: company?.city || 'Köln',
    postalCode: company?.zip || '50670',
    addressCountry: 'DE'
  },
  contactPoint: {
    '@type': 'ContactPoint',
    telephone: company?.phoneIntl || '+498008888369',
    contactType: 'customer service',
    email: company?.email || 'info@metra-baulogistik.de'
  },
  sameAs: []
};

const localBusinessSchema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: company?.name || 'METRA Baulogistik & Projektsteuerung GmbH',
  image: `${siteUrl}${ogImage}`,
  address: {
    '@type': 'PostalAddress',
    streetAddress: company?.street || 'Im Mediapark 5',
    addressLocality: company?.city || 'Köln',
    postalCode: company?.zip || '50670',
    addressCountry: 'DE'
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: '50.9484',
    longitude: '6.9525'
  },
  url: siteUrl,
  telephone: company?.phoneIntl || '+498008888369',
  priceRange: '€€',
  openingHoursSpecification: {
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
    opens: '00:00',
    closes: '23:59'
  }
};
---

<!DOCTYPE html>
<html lang="de-DE" dir="ltr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="METRA Baulogistik & Projektsteuerung GmbH" />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <link rel="canonical" href={fullCanonical} />
    
    <!-- Favicon - Complete Set (Cache Busted) -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
    <!-- TODO: Generate a 180x180 PNG from favicon.svg for optimal iOS compatibility and update src below -->
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon.svg?v=2" />
    <link rel="manifest" href="/site.webmanifest?v=2" />
    
    <!-- Safari Pinned Tab & Windows Tile -->
    <link rel="mask-icon" href="/favicon.svg" color="#dab252" />
    <meta name="msapplication-TileColor" content="#00002e" />
    
    <!-- Preconnect für Performance -->
    <link rel="preconnect" href="https://api.web3forms.com" />
    
    <!-- Preload Fonts -->
    <link rel="preload" href="/fonts/inter-regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-600.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-700.woff2" as="font" type="font/woff2" crossorigin />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={fullCanonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${siteUrl}${ogImage}`} />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:site_name" content="METRA Baulogistik" />
    
    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={fullCanonical} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${siteUrl}${ogImage}`} />
    
    <!-- Schema.org -->
    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />
    
    <slot name="head" />
    
    <!-- Theme Color -->
    <meta name="theme-color" content="#00002e" />
    
    <!-- Critical CSS Inline für Above-the-fold -->
    <style is:inline>
      /* Critical CSS */
      body {
        background-color: #00002e;
        color: #ffffff;
        margin: 0;
        font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      }
      
      /* Font Display Swap */
      @font-face {
        font-family: 'Inter';
        src: url('/fonts/inter-regular.woff2') format('woff2');
        font-weight: 400;
        font-style: normal;
        font-display: swap;
      }
    </style>
  </head>
  
  <body class="min-h-screen flex flex-col">
    <a 
      href="#main-content" 
      class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 bg-accent text-background px-4 py-2 rounded font-medium z-50"
    >
      Zum Hauptinhalt springen
    </a>
    
    <slot />
    
    <CookieBanner />
  </body>
</html>
