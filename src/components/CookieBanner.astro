---
import { getEntry } from 'astro:content';

const settings = await getEntry('settings', 'global');
const cb = settings?.data?.cookieBanner;
---

<div 
  id="cookie-banner" 
  class="fixed bottom-0 left-0 right-0 z-50 bg-background/95 backdrop-blur-sm border-t border-white/10 transform translate-y-full transition-transform duration-300"
  role="dialog"
  aria-label="Cookie-Einwilligung"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4 pb-[max(1rem,env(safe-area-inset-bottom))]">
    <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
      <div class="flex-1">
        <h3 class="text-white font-semibold text-sm mb-1">{cb?.title || 'Datenschutzeinstellungen'}</h3>
        <p class="text-white/80 text-sm">
          {cb?.description || 'Wir verwenden Cookies, um Ihnen die bestmögliche Erfahrung auf unserer Website zu bieten.'}
          <a href="/datenschutz" class="underline hover:text-accent transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-accent rounded">{cb?.linkText || 'Mehr erfahren'}</a>
        </p>
      </div>
      <div class="flex flex-wrap gap-2 sm:gap-3">
        <button 
          id="cookie-essential"
          class="px-4 py-3 min-h-[44px] min-w-[44px] text-sm font-medium text-white bg-white/10 hover:bg-white/20 rounded transition-colors touch-manipulation"
          aria-label="Nur essenzielle Cookies akzeptieren"
        >
          {cb?.essentialLabel || 'Nur Essenzielle'}
        </button>
        <button 
          id="cookie-decline"
          class="px-4 py-3 min-h-[44px] min-w-[44px] text-sm font-medium text-white bg-white/10 hover:bg-white/20 rounded transition-colors touch-manipulation"
          aria-label="Cookies ablehnen"
        >
          {cb?.declineLabel || 'Ablehnen'}
        </button>
        <button 
          id="cookie-accept"
          class="px-4 py-3 min-h-[44px] min-w-[44px] text-sm font-medium text-background bg-accent hover:bg-accent-hover rounded transition-colors touch-manipulation"
          aria-label="Alle Cookies akzeptieren"
        >
          {cb?.acceptLabel || 'Zustimmen'}
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  (function() {
    const COOKIE_KEY = 'metra_cookie_consent';
    const banner = document.getElementById('cookie-banner');
    const acceptBtn = document.getElementById('cookie-accept');
    const declineBtn = document.getElementById('cookie-decline');
    const essentialBtn = document.getElementById('cookie-essential');

    // Prüfen ob bereits entschieden wurde
    const consent = localStorage.getItem(COOKIE_KEY);
    
    if (!consent) {
      // Banner anzeigen mit kleiner Verzögerung für bessere UX
      setTimeout(() => {
        banner?.classList.remove('translate-y-full');
      }, 1000);
    }

    function setConsent(choice: string) {
      localStorage.setItem(COOKIE_KEY, choice);
      banner?.classList.add('translate-y-full');
      
      // Custom Event für Tracking (nur wenn zugestimmt wurde)
      if (choice === 'accepted') {
        window.dispatchEvent(new CustomEvent('cookieConsentAccepted'));
      }
    }

    acceptBtn?.addEventListener('click', () => setConsent('accepted'));
    declineBtn?.addEventListener('click', () => setConsent('declined'));
    essentialBtn?.addEventListener('click', () => setConsent('essential'));
  })();
</script>
