---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import { getEntry } from 'astro:content';

const homepage = await getEntry('homepage', 'index');
const h = homepage?.data;

const hero = h?.hero;
const problemSolution = h?.problemSolution;
const process = h?.process;
const services = h?.services;
const whyMetra = h?.whyMetra;

const schemaBreadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Startseite',
      item: 'https://www.metra-baulogistik.de',
    },
  ],
};
---

<Layout 
  title={h?.meta?.title}
  description={h?.meta?.description}
  canonical="/"
>
  <script type="application/ld+json" set:html={JSON.stringify(schemaBreadcrumb)} />
  
  <Header />
  
  <main id="main-content">
    <!-- Hero Section WITH IMAGE -->
    <section 
      class="relative min-h-[90vh] flex items-center overflow-hidden"
      aria-labelledby="hero-title"
    >
      <!-- Background Pattern -->
      <div class="absolute inset-0 opacity-5" aria-hidden="true">
        <div class="absolute inset-0" style="background-image: radial-gradient(circle at 2px 2px, white 1px, transparent 0); background-size: 40px 40px;"></div>
      </div>
      
      <div class="relative max-w-7xl mx-auto px-3 sm:px-4 lg:px-8 py-16 sm:py-24 md:py-32 lg:py-40">
        <div class="grid lg:grid-cols-2 gap-8 lg:gap-12 xl:gap-16 items-center">
          <!-- Left: Text Content -->
          <div class="max-w-2xl order-1">
            <!-- Tagline -->
            <p class="text-accent font-semibold tracking-wider text-sm md:text-base mb-3 sm:mb-4 animate-fade-in">
              {hero?.tagline}
            </p>
            
            <!-- Claim -->
            <p class="text-accent/80 text-sm md:text-base mb-2 animate-fade-in">
              {hero?.claim}
            </p>
            
            <!-- Main Headline -->
            <h1 
              id="hero-title" 
              class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-bold text-white leading-tight mb-4 sm:mb-6 animate-fade-in-up"
            >
              {hero?.title}
            </h1>
            
            <!-- Subheadline -->
            <p class="text-base sm:text-lg md:text-xl text-secondary leading-relaxed mb-3 sm:mb-4 animate-fade-in-up" style="animation-delay: 0.1s;">
              {hero?.subtitle}
            </p>
            
            <!-- USP Tags -->
            <div class="flex flex-wrap gap-2 sm:gap-3 mb-0 animate-fade-in-up" style="animation-delay: 0.2s;">
              <span class="inline-flex items-center gap-1.5 px-2.5 sm:px-3 py-1.5 bg-accent/10 border border-accent/20 rounded-full text-accent text-xs sm:text-sm font-medium">
                <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd"/>
                </svg>
                {hero?.usp1}
              </span>
              <span class="inline-flex items-center gap-1.5 px-2.5 sm:px-3 py-1.5 bg-accent/10 border border-accent/20 rounded-full text-accent text-xs sm:text-sm font-medium">
                <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                  <path fill-rule="evenodd" d="M6.267 3.455a3.066 3.066 0 001.745-.723 3.066 3.066 0 013.976 0 3.066 3.066 0 001.745.723 3.066 3.066 0 012.812 2.812c.051.643.304 1.254.723 1.745a3.066 3.066 0 010 3.976 3.066 3.066 0 00-.723 1.745 3.066 3.066 0 01-2.812 2.812 3.066 3.066 0 00-1.745.723 3.066 3.066 0 01-3.976 0 3.066 3.066 0 00-1.745-.723 3.066 3.066 0 01-2.812-2.812 3.066 3.066 0 00-.723-1.745 3.066 3.066 0 010-3.976 3.066 3.066 0 00.723-1.745 3.066 3.066 0 012.812-2.812zm7.44 5.252a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                </svg>
                {hero?.usp2}
              </span>
            </div>
          </div>
          
          <!-- Right: Hero Image -->
          <div class="relative order-2 lg:order-2 animate-fade-in-up" style="animation-delay: 0.2s;">
            {/* Decorative Glow */}
            <div class="absolute inset-0 bg-accent/5 rounded-full blur-3xl scale-110" aria-hidden="true"></div>
            
            {/* Hero Image Container */}
            <div class="relative w-full">
              <div class="relative aspect-[4/3] sm:aspect-[16/10] lg:aspect-auto lg:h-[500px] xl:h-[550px] rounded-2xl overflow-hidden shadow-2xl">
                <img 
                  src={hero?.image} 
                  alt={hero?.imageAlt}
                  class="w-full h-full object-cover object-top"
                  width="700"
                  height="525"
                  loading="eager"
                  fetchpriority="high"
                />
              </div>
              
              {/* 24/7 Badge - Top Left (All Devices) */}
              <div class="absolute top-3 left-3 sm:top-4 sm:left-4 bg-accent text-background rounded-xl p-2.5 sm:p-3 shadow-xl">
                <div class="flex items-center gap-1.5 sm:gap-2">
                  <svg class="w-4 h-4 sm:w-5 sm:h-5" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd"/>
                  </svg>
                  <span class="font-bold text-xs sm:text-sm">24/7 Service</span>
                </div>
              </div>
              
              {/* 100% Badge - Bottom Right (All Devices) */}
              <div class="absolute bottom-3 right-3 sm:bottom-4 sm:right-4 bg-background border border-accent/20 rounded-xl p-2 sm:p-3 shadow-xl">
                <div class="flex items-center gap-2 sm:gap-3">
                  <div class="w-8 h-8 sm:w-10 sm:h-10 bg-accent/10 rounded-lg flex items-center justify-center">
                    <svg class="w-4 h-4 sm:w-5 sm:h-5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                  </div>
                  <div>
                    <p class="text-white font-bold text-sm sm:text-base">{hero?.badge2Text}</p>
                    <p class="text-secondary text-[10px] sm:text-xs">{hero?.badge2Label}</p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
        
        {/* CTA Buttons - Below Hero on Mobile, Same row on Desktop */}
        <div class="mt-8 lg:mt-0 lg:absolute lg:bottom-0 lg:left-0 lg:right-0 lg:pointer-events-none">
          <div class="max-w-2xl lg:max-w-none lg:px-0 animate-fade-in-up" style="animation-delay: 0.3s;">
            <div class="flex flex-col sm:flex-row gap-3 sm:gap-4 lg:hidden">
              <a 
                href="/kontakt"
                class="inline-flex items-center justify-center px-4 sm:px-8 py-3.5 sm:py-4 bg-accent text-background font-bold text-sm sm:text-base rounded hover:bg-accent-hover active:scale-[0.98] active:bg-accent-hover transition-all duration-150 focus:outline-none focus-visible:ring-4 focus-visible:ring-accent/50"
                aria-label="Jetzt Projekt anfragen"
              >
                {hero?.ctaPrimary?.text}
                <svg class="w-4 h-4 sm:w-5 sm:h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                </svg>
              </a>
              <a 
                href="/leistungen"
                class="inline-flex items-center justify-center px-4 sm:px-8 py-3.5 sm:py-4 border-2 border-secondary/30 text-white font-semibold text-sm sm:text-base rounded hover:border-accent hover:text-accent transition-colors focus:outline-none focus-visible:ring-4 focus-visible:ring-accent/50"
                aria-label="Alle Leistungen ansehen"
              >
                {hero?.ctaSecondary?.text}
              </a>
            </div>
            
            {/* Desktop CTA Buttons - Inside text column */}
            <div class="hidden lg:flex flex-col sm:flex-row gap-3 sm:gap-4 pointer-events-auto">
              <a 
                href="/kontakt"
                class="inline-flex items-center justify-center px-4 sm:px-8 py-3.5 sm:py-4 bg-accent text-background font-bold text-sm sm:text-base rounded hover:bg-accent-hover active:scale-[0.98] active:bg-accent-hover transition-all duration-150 focus:outline-none focus-visible:ring-4 focus-visible:ring-accent/50"
                aria-label="Jetzt Projekt anfragen"
              >
                Projekt anfragen
                <svg class="w-4 h-4 sm:w-5 sm:h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                </svg>
              </a>
              <a 
                href="/leistungen"
                class="inline-flex items-center justify-center px-4 sm:px-8 py-3.5 sm:py-4 border-2 border-secondary/30 text-white font-semibold text-sm sm:text-base rounded hover:border-accent hover:text-accent transition-colors focus:outline-none focus-visible:ring-4 focus-visible:ring-accent/50"
                aria-label="Alle Leistungen ansehen"
              >
                Leistungen ansehen
              </a>
            </div>
          </div>
        </div>
      </div>
      
      {/* Scroll Indicator */}
      <div class="absolute bottom-8 left-1/2 transform -translate-x-1/2 hidden md:block" aria-hidden="true">
        <div class="w-6 h-10 border-2 border-secondary/30 rounded-full flex justify-center pt-2">
          <div class="w-1.5 h-3 bg-accent rounded-full animate-bounce"></div>
        </div>
      </div>
    </section>

    <!-- Problem / Solution Section -->
    <section class="py-16 sm:py-24 md:py-40 bg-white/[0.02]" aria-labelledby="problem-solution-title">
      <div class="max-w-7xl mx-auto px-3 sm:px-4 lg:px-8">
        <div class="grid md:grid-cols-2 gap-8 sm:gap-12 lg:gap-20 items-center">
          <div>
            <h2 id="problem-solution-title" class="sr-only">Problem und Lösung</h2>
            <p class="text-accent font-semibold tracking-wider text-sm mb-3">{problemSolution?.problemLabel}</p>
            <h3 class="text-3xl md:text-4xl font-bold text-white mb-6">
              {problemSolution?.problemTitle}
            </h3>
            <p class="text-secondary text-lg mb-6">
              {problemSolution?.problemText1}
            </p>
            <p class="text-secondary text-lg">
              {problemSolution?.problemText2}
            </p>
          </div>
          
          <div class="bg-background border border-accent/20 rounded-xl sm:rounded-2xl p-5 sm:p-8 md:p-10">
            <p class="text-accent font-semibold tracking-wider text-sm mb-3">{problemSolution?.solutionLabel}</p>
            <h3 class="text-3xl md:text-4xl font-bold text-white mb-6">
              {problemSolution?.solutionTitle}
            </h3>
            <p class="text-secondary text-lg mb-8">
              {problemSolution?.solutionText}
            </p>
            
            <!-- Benefits Grid -->
            <div class="grid sm:grid-cols-2 gap-3 sm:gap-4">
              {problemSolution?.benefits?.map((benefit, index) => (
                <div class="flex items-start gap-2 sm:gap-3 p-3 sm:p-4 bg-white/[0.03] rounded-lg">
                  <div class="w-8 h-8 sm:w-10 sm:h-10 bg-accent/10 rounded-lg flex items-center justify-center flex-shrink-0">
                    <svg class="w-4 h-4 sm:w-5 sm:h-5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={benefit.icon}/>
                    </svg>
                  </div>
                  <div>
                    <h4 class="text-white font-semibold text-xs sm:text-sm mb-0.5 sm:mb-1">{benefit.title}</h4>
                    <p class="text-secondary text-[10px] sm:text-xs leading-relaxed">{benefit.description}</p>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 4-Step Process -->
    <section class="py-16 sm:py-24 md:py-40" aria-labelledby="process-title">
      <div class="max-w-7xl mx-auto px-3 sm:px-4 lg:px-8">
        <div class="text-center max-w-3xl mx-auto mb-10 sm:mb-16">
          <p class="text-accent font-semibold tracking-wider text-xs sm:text-sm mb-2 sm:mb-3">{process?.label}</p>
          <h2 id="process-title" class="text-2xl sm:text-3xl md:text-4xl font-bold text-white mb-3 sm:mb-4">
            {process?.title}
          </h2>
          <p class="text-secondary text-base sm:text-lg">
            {process?.subtitle}
          </p>
        </div>
        
        <div class="max-w-3xl mx-auto">
          {process?.steps?.map((step, index) => (
            <div class="relative flex gap-4 sm:gap-6">
              {/* Timeline line */}
              {index !== process?.steps?.length - 1 && (
                <div class="absolute left-6 sm:left-7 top-14 sm:top-16 bottom-0 w-px bg-white/10" aria-hidden="true"></div>
              )}
              
              {/* Icon */}
              <div class="relative z-10 w-12 h-12 sm:w-14 sm:h-14 bg-accent/10 rounded-xl flex items-center justify-center flex-shrink-0">
                <svg class="w-6 h-6 sm:w-7 sm:h-7 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={step.icon}/>
                </svg>
              </div>
              
              {/* Content */}
              <div class="pb-8 sm:pb-12 pt-1">
                <h3 class="text-lg sm:text-xl font-bold text-white mb-1 sm:mb-2">{step.title}</h3>
                <p class="text-secondary text-sm sm:text-base leading-relaxed">{step.description}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Services Teaser WITH IMAGES -->
    <section class="py-16 sm:py-24 md:py-40 bg-white/[0.02]" aria-labelledby="services-title">
      <div class="max-w-7xl mx-auto px-3 sm:px-4 lg:px-8">
        <div class="text-center max-w-3xl mx-auto mb-10 sm:mb-16">
          <p class="text-accent font-semibold tracking-wider text-xs sm:text-sm mb-2 sm:mb-3">{services?.label}</p>
          <h2 id="services-title" class="text-2xl sm:text-3xl md:text-4xl font-bold text-white mb-3 sm:mb-4">
            {services?.title}
          </h2>
          <p class="text-secondary text-base sm:text-lg">
            {services?.subtitle}
          </p>
        </div>
        
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6">
          {services?.items?.map((service) => (
            <a 
              href={`/leistungen#${service.id}`}
              class="group block bg-background border border-white/5 rounded-xl overflow-hidden hover:border-accent/30 transition-all hover:-translate-y-1 focus:outline-none focus-visible:ring-4 focus-visible:ring-accent/50"
            >
              <!-- Service Image -->
              <div class="relative overflow-hidden" style="aspect-ratio: 16/9;">
                <img 
                  src={service.image} 
                  alt={service.title}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                  loading="lazy"
                  width="400"
                  height="225"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-background to-transparent opacity-60"></div>
              </div>
              
              <div class="p-4 sm:p-6">
                <div class="w-10 h-10 sm:w-12 sm:h-12 bg-accent/10 rounded-lg flex items-center justify-center mb-3 sm:mb-4 group-hover:bg-accent/20 transition-colors">
                  <svg class="w-5 h-5 sm:w-6 sm:h-6 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={service.icon}/>
                  </svg>
                </div>
                <h3 class="text-base sm:text-lg font-bold text-white mb-1.5 sm:mb-2 group-hover:text-accent transition-colors">
                  {service.title}
                </h3>
                <p class="text-secondary text-xs sm:text-sm leading-relaxed mb-3 sm:mb-4">
                  {service.description}
                </p>
                <span class="inline-flex items-center text-accent text-xs sm:text-sm font-medium">
                  Mehr erfahren
                  <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4 ml-1 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                  </svg>
                </span>
              </div>
            </a>
          ))}
        </div>
        
        <div class="text-center mt-8 sm:mt-12">
          <a 
            href="/leistungen"
            class="inline-flex items-center justify-center px-5 sm:px-8 py-3 sm:py-4 border-2 border-accent text-accent font-semibold text-sm sm:text-base rounded hover:bg-accent hover:text-background active:scale-[0.98] transition-all duration-150 focus:outline-none focus-visible:ring-4 focus-visible:ring-accent/50"
            aria-label="Alle Leistungen im Detail ansehen"
          >
            {services?.ctaText}
            <svg class="w-4 h-4 sm:w-5 sm:h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
            </svg>
          </a>
        </div>
      </div>
    </section>

    <!-- Warum METRA Section -->
    <section class="py-16 sm:py-24 md:py-40 bg-white/[0.02]" aria-labelledby="why-metra-title">
      <div class="max-w-7xl mx-auto px-3 sm:px-4 lg:px-8">
        <div class="text-center max-w-3xl mx-auto mb-10 sm:mb-16">
          <h2 id="why-metra-title" class="text-2xl sm:text-3xl md:text-4xl font-bold text-white mb-3 sm:mb-4">
            {whyMetra?.title}
          </h2>
          <p class="text-accent text-base sm:text-lg">{whyMetra?.subtitle}</p>
        </div>
        
        <div class="grid sm:grid-cols-2 lg:grid-cols-2 gap-4 sm:gap-6 max-w-5xl mx-auto">
          {whyMetra?.items?.map((item) => (
            <div class="flex items-start gap-3 sm:gap-4 bg-white/[0.03] p-4 sm:p-6 rounded-xl">
              <svg class="w-6 h-6 text-accent flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
              <span class="text-white text-base sm:text-lg">{item.text}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

  </main>
  
  <Footer />
  <WhatsAppButton />
</Layout>
