---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import { getEntry } from 'astro:content';
import { renderMarkdown } from '../utils/markdown';

const datenschutz = await getEntry('datenschutz', 'index');
const d = datenschutz?.data;

const schemaBreadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Startseite',
      item: 'https://www.metra-baulogistik.de',
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Datenschutz',
      item: 'https://www.metra-baulogistik.de/datenschutz',
    },
  ],
};

const sectionContents = d?.sections ? await Promise.all(d.sections.map(async (s) => ({
  ...s,
  html: await renderMarkdown(s.content)
}))) : [];
---

<Layout 
  title={d?.title}
  description={d?.description}
  canonical="/datenschutz"
>
  <script type="application/ld+json" set:html={JSON.stringify(schemaBreadcrumb)} />
  
  <Header />
  
  <main id="main-content">
    <!-- Hero Section -->
    <section class="relative py-16 md:py-24 overflow-hidden" aria-labelledby="privacy-title">
      <div class="absolute inset-0 opacity-5" aria-hidden="true">
        <div class="absolute inset-0" style="background-image: radial-gradient(circle at 2px 2px, white 1px, transparent 0); background-size: 40px 40px;"></div>
      </div>
      
      <div class="relative max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <nav aria-label="Breadcrumb">
          <ol class="flex items-center gap-2 text-sm text-secondary mb-6">
            <li><a href="/" class="hover:text-accent transition-colors">Startseite</a></li>
            <li aria-hidden="true">/</li>
            <li aria-current="page" class="text-accent">Datenschutz</li>
          </ol>
        </nav>
        
        <p class="text-accent font-semibold tracking-wider text-sm mb-4">{d?.heroLabel}</p>
        <h1 id="privacy-title" class="text-3xl sm:text-4xl md:text-5xl font-bold text-white leading-tight break-words">
          {d?.heroTitle}
        </h1>
      </div>
    </section>

    <!-- Content Section -->
    <section class="py-12 md:py-20 bg-white/[0.02]" aria-label="Datenschutzinformationen">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="prose prose-invert max-w-none">
          {sectionContents.map((section) => (
            <article class="mb-12">
              <h2 class="text-2xl font-bold text-white mb-6">{section.title}</h2>
              <div class="bg-white/[0.03] border border-white/5 rounded-xl p-6 md:p-8">
                <div class="not-italic space-y-4 text-secondary prose prose-invert max-w-none" set:html={section.html} />
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  </main>
  
  <Footer />
  <WhatsAppButton />
</Layout>
