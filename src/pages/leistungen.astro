---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import { getCollection, getEntry } from 'astro:content';

const pageData = await getEntry('leistungenPage', 'index');
const services = await getCollection('leistungen');

const p = pageData?.data;

const schemaBreadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Startseite',
      item: 'https://www.metra-baulogistik.de',
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Leistungen',
      item: 'https://www.metra-baulogistik.de/leistungen',
    },
  ],
};

const schemaService = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'Baulogistik und Projektsteuerung',
  provider: {
    '@type': 'Organization',
    name: 'METRA Baulogistik & Projektsteuerung GmbH',
  },
  areaServed: {
    '@type': 'City',
    name: 'Köln',
  },
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Baulogistik Leistungen',
    itemListElement: services.map((service) => ({
      '@type': 'Offer',
      itemOffered: {
        '@type': 'Service',
        name: service.data.title,
        description: service.data.description,
      },
    })),
  },
};
---

<Layout 
  title={p?.title}
  description={p?.description}
  canonical="/leistungen"
>
  <script type="application/ld+json" set:html={JSON.stringify(schemaBreadcrumb)} />
  <script type="application/ld+json" set:html={JSON.stringify(schemaService)} />
  
  <Header />
  
  <main id="main-content">
    <!-- Hero Section -->
    <section class="relative py-20 md:py-32 overflow-hidden" aria-labelledby="services-hero-title">
      <div class="absolute inset-0 opacity-5" aria-hidden="true">
        <div class="absolute inset-0" style="background-image: radial-gradient(circle at 2px 2px, white 1px, transparent 0); background-size: 40px 40px;"></div>
      </div>
      
      <div class="relative max-w-7xl mx-auto px-3 sm:px-4 lg:px-8">
        <div class="max-w-3xl">
          <nav aria-label="Breadcrumb">
            <ol class="flex items-center gap-2 text-xs sm:text-sm text-secondary mb-4 sm:mb-6">
              <li><a href="/" class="hover:text-accent transition-colors">Startseite</a></li>
              <li aria-hidden="true">/</li>
              <li aria-current="page" class="text-accent">Leistungen</li>
            </ol>
          </nav>
          
          <p class="text-accent font-semibold tracking-wider text-xs sm:text-sm mb-3 sm:mb-4">{p?.hero?.label}</p>
          <h1 id="services-hero-title" class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-bold text-white leading-tight mb-4 sm:mb-6">
            {p?.hero?.title}
          </h1>
          <p class="text-base sm:text-lg md:text-xl text-secondary leading-relaxed max-w-2xl">
            {p?.hero?.text}
          </p>
        </div>
      </div>
    </section>

    <!-- Services Detail Section WITH IMAGES -->
    <section class="py-16 sm:py-20 md:py-32 bg-white/[0.02]" aria-labelledby="services-detail-title">
      <div class="max-w-7xl mx-auto px-3 sm:px-4 lg:px-8">
        <h2 id="services-detail-title" class="sr-only">Detaillierte Leistungsübersicht</h2>
        
        <div class="space-y-16 sm:space-y-20 md:space-y-32">
          {services.map((entry, index) => {
            const service = entry.data;
            return (
            <article 
              id={service.id}
              class="grid lg:grid-cols-2 gap-8 lg:gap-16 items-center"
            >
              {/* Image - alternates left/right */}
              <div class={`relative ${index % 2 === 1 ? 'lg:order-2' : ''}`}>
                <div class="relative rounded-xl sm:rounded-2xl overflow-hidden aspect-[16/10] sm:aspect-[16/9]">
                  <img 
                    src={service.image} 
                    alt={service.title}
                    class="w-full h-full object-cover"
                    loading="lazy"
                    width="600"
                    height="450"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-background/80 via-transparent to-transparent"></div>
                  

                </div>
                
                {/* Decorative element */}
                <div class="absolute -bottom-4 -right-4 w-24 h-24 bg-accent/10 rounded-full blur-2xl" aria-hidden="true"></div>
              </div>
              
              {/* Content */}
              <div class={`${index % 2 === 1 ? 'lg:order-1' : ''} mt-6 lg:mt-0`}>
                <div class="inline-flex items-center gap-2 px-3 py-1 bg-accent/10 rounded-full text-accent text-xs sm:text-sm font-medium mb-3 sm:mb-4">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={service.icon}/>
                  </svg>
                  Leistungsbereich
                </div>
                <h3 class="text-xl sm:text-2xl md:text-3xl font-bold text-white mb-3 sm:mb-4">
                  {service.title}
                </h3>
                <p class="text-secondary text-lg leading-relaxed mb-6">
                  {service.description}
                </p>
                
                <h4 class="text-white font-semibold mb-3">{service.heading}:</h4>
                <ul class="space-y-2">
                  {service.features.map((feature: string) => (
                    <li class="flex items-start gap-3">
                      <svg class="w-5 h-5 text-accent flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                      </svg>
                      <span class="text-secondary">{feature}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </article>
          )})}
        </div>
      </div>
    </section>

    <!-- Benefits Section -->
    <section class="py-16 sm:py-20 md:py-32" aria-labelledby="benefits-title">
      <div class="max-w-7xl mx-auto px-3 sm:px-4 lg:px-8">
        <div class="text-center max-w-3xl mx-auto mb-10 sm:mb-16">
          <p class="text-accent font-semibold tracking-wider text-xs sm:text-sm mb-2 sm:mb-3">IHR VORTEIL</p>
          <h2 id="benefits-title" class="text-2xl sm:text-3xl md:text-4xl font-bold text-white mb-3 sm:mb-4">
            Warum METRA?
          </h2>
          <p class="text-secondary text-base sm:text-lg">
            Überzeugende Argumente für eine Zusammenarbeit mit uns.
          </p>
        </div>
        
        <div class="grid sm:grid-cols-2 md:grid-cols-3 gap-6 sm:gap-8">
          {p?.benefits?.map((benefit) => (
            <div class="text-center">
              <div class="w-12 h-12 sm:w-16 sm:h-16 bg-accent/10 rounded-xl sm:rounded-2xl flex items-center justify-center mx-auto mb-3 sm:mb-4">
                <svg class="w-6 h-6 sm:w-8 sm:h-8 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={benefit.icon}/>
                </svg>
              </div>
              <h3 class="text-lg sm:text-xl font-bold text-white mb-1 sm:mb-2">{benefit.title}</h3>
              <p class="text-secondary text-sm sm:text-base">{benefit.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Process Teaser -->
    <section class="py-16 sm:py-20 md:py-32 bg-white/[0.02]" aria-labelledby="process-teaser-title">
      <div class="max-w-7xl mx-auto px-3 sm:px-4 lg:px-8">
        <div class="grid lg:grid-cols-2 gap-8 sm:gap-12 items-center">
          <div>
            <p class="text-accent font-semibold tracking-wider text-sm mb-3">UNSER VORGEHEN</p>
            <h2 id="process-teaser-title" class="text-3xl md:text-4xl font-bold text-white mb-4">
              Strukturiert zum Projekterfolg
            </h2>
            <p class="text-secondary text-lg mb-6">
              Unser bewährter 4-Schritte-Ansatz garantiert eine professionelle Abwicklung Ihres Bauprojekts – von der ersten Analyse bis zur finalen Dokumentation.
            </p>
            <a 
              href="/#process-title"
              class="inline-flex items-center text-accent font-semibold hover:underline focus:outline-none focus-visible:ring-2 focus-visible:ring-accent rounded"
            >
              4-Schritte-Ansatz ansehen
              <svg class="w-5 h-5 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
              </svg>
            </a>
          </div>
          
          <div class="grid grid-cols-2 gap-4">
            {[
              { num: '01', title: 'Analyse', desc: 'Vor-Ort-Bedarfsanalyse' },
              { num: '02', title: 'Konzept', desc: 'Maßgeschneidertes Konzept' },
              { num: '03', title: 'Einsatz', desc: 'Qualifiziertes Team vor Ort' },
              { num: '04', title: 'Reporting', desc: 'Lückenlose Dokumentation' },
            ].map((step) => (
              <div class="bg-background border border-white/5 rounded-xl p-6 text-center">
                <span class="text-3xl font-bold text-accent">{step.num}</span>
                <h3 class="text-white font-semibold mt-2 mb-1">{step.title}</h3>
                <p class="text-secondary text-sm">{step.desc}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="py-16 sm:py-20 md:py-32" aria-labelledby="services-cta-title">
      <div class="max-w-5xl mx-auto px-3 sm:px-4 lg:px-8">
        <div class="relative bg-accent rounded-xl sm:rounded-2xl p-6 sm:p-8 md:p-16 overflow-hidden">
          <div class="absolute inset-0 opacity-10" aria-hidden="true">
            <div class="absolute inset-0" style="background-image: radial-gradient(circle at 2px 2px, #00002e 1px, transparent 0); background-size: 24px 24px;"></div>
          </div>
          
          <div class="relative text-center">
            <h2 id="services-cta-title" class="text-3xl md:text-4xl lg:text-5xl font-bold text-background mb-4">
              {p?.cta?.title}
            </h2>
            <p class="text-background/80 text-lg md:text-xl mb-8 max-w-2xl mx-auto">
              {p?.cta?.text}
            </p>
            <div class="flex flex-col sm:flex-row gap-4 justify-center">
              <a 
                href={p?.cta?.buttonUrl || '/kontakt'}
                class="inline-flex items-center justify-center px-8 py-4 bg-background text-white font-bold text-base rounded hover:bg-background/90 active:scale-[0.98] transition-all duration-150 focus:outline-none focus-visible:ring-4 focus-visible:ring-background/50"
                aria-label="Jetzt Kontakt aufnehmen"
              >
                {p?.cta?.buttonText}
                <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                </svg>
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>


  </main>
  
  <Footer />
  <WhatsAppButton />
</Layout>
