---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import { getEntry } from 'astro:content';
import { renderMarkdown } from '../utils/markdown';

const impressum = await getEntry('impressum', 'index');
const i = impressum?.data;

const settings = await getEntry('settings', 'global');
const company = settings?.data?.company;

const companyInfo = {
  name: company?.name || 'METRA Baulogistik & Projektsteuerung GmbH',
  legalForm: company?.legalForm || 'GmbH',
  owner: company?.owner || 'Sascha Trajkovic',
  street: company?.street || 'Im Mediapark 5',
  zip: company?.zip || '50670',
  city: company?.city || 'Köln',
  country: company?.country || 'Deutschland',
  phone: company?.phoneDisplay || '0800 8888369',
  phoneRaw: company?.phoneRaw || '08008888369',
  email: company?.email || 'info@metra-baulogistik.de',
  web: company?.web || 'www.metra-baulogistik.de',
  vatId: company?.vatId || 'DE [USt-IdNr. wird ergänzt]',
  registration: company?.registration || '[Handelsregisternummer wird ergänzt]',
  registryCourt: company?.registryCourt || 'Amtsgericht Köln',
  responsible: company?.owner || 'Sascha Trajkovic',
};

const schemaBreadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Startseite',
      item: 'https://www.metra-baulogistik.de',
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Impressum',
      item: 'https://www.metra-baulogistik.de/impressum',
    },
  ],
};

const sectionContents = i?.sections ? await Promise.all(i.sections.map(async (s) => ({
  ...s,
  html: await renderMarkdown(s.content)
}))) : [];
---

<Layout 
  title={i?.title}
  description={i?.description}
  canonical="/impressum"
>
  <script type="application/ld+json" set:html={JSON.stringify(schemaBreadcrumb)} />
  
  <Header />
  
  <main id="main-content">
    <!-- Hero Section -->
    <section class="relative py-16 md:py-24 overflow-hidden" aria-labelledby="imprint-title">
      <div class="absolute inset-0 opacity-5" aria-hidden="true">
        <div class="absolute inset-0" style="background-image: radial-gradient(circle at 2px 2px, white 1px, transparent 0); background-size: 40px 40px;"></div>
      </div>
      
      <div class="relative max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <nav aria-label="Breadcrumb">
          <ol class="flex items-center gap-2 text-sm text-secondary mb-6">
            <li><a href="/" class="hover:text-accent transition-colors">Startseite</a></li>
            <li aria-hidden="true">/</li>
            <li aria-current="page" class="text-accent">Impressum</li>
          </ol>
        </nav>
        
        <p class="text-accent font-semibold tracking-wider text-sm mb-4">{i?.heroLabel}</p>
        <h1 id="imprint-title" class="text-4xl md:text-5xl font-bold text-white leading-tight">
          {i?.heroTitle}
        </h1>
      </div>
    </section>

    <!-- Content Section -->
    <section class="py-12 md:py-20 bg-white/[0.02]" aria-label="Impressumsangaben">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="prose prose-invert max-w-none">
          {sectionContents.map((section) => (
            <article class="mb-12">
              <h2 class="text-2xl font-bold text-white mb-6">{section.title}</h2>
              <div class="bg-white/[0.03] border border-white/5 rounded-xl p-6 md:p-8">
                <div class="not-italic space-y-4 text-secondary prose prose-invert max-w-none" set:html={section.html} />
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  </main>
  
  <Footer />
  <WhatsAppButton />
</Layout>
